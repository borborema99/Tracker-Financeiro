{
  "name": "tracker-financeiro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Controle financeiro pessoal que roda na sua máquina",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "dev": "node scripts/dev.js",
    "build": "vite build --config web/vite.config.js",
    "start": "node servidor/index.js",
    "iniciar:rede": "node scripts/iniciar-rede.js",
    "demo": "node scripts/demo.js",
    "backup": "node scripts/backup.js",
    "restaurar": "node scripts/restaurar.js",
    "redefinir-senha": "node scripts/redefinir-senha.js",
    "lint": "eslint .",
    "test": "node --test --test-reporter=./tests/reporter-falhas.js \"tests/**/*.test.js\"",
    "verify": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.9",
    "@tanstack/react-query": "^5.105.3",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.8",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "vite": "^8.3.5"
  }
}
