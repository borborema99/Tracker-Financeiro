{
  "name": "tracker-financeiro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Controle financeiro pessoal, multiusuário, para publicar no Netlify com Supabase",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.js",
    "dev": "node scripts/dev.js",
    "build": "vite build --config frontend/vite.config.ts",
    "start": "node servidor/index.js",
    "criar-usuario": "node scripts/criar-usuario.js",
    "demo": "node scripts/demo.js",
    "backup": "node scripts/backup.js",
    "restaurar": "node scripts/restaurar.js",
    "redefinir-senha": "node scripts/redefinir-senha.js",
    "lint": "eslint . --ignore-pattern frontend/dist/",
    "typecheck": "tsc -p frontend/tsconfig.json",
    "test": "npm run test:servidor && npm run test:frontend",
    "test:servidor": "node --test --test-reporter=./tests/reporter-falhas.js \"tests/**/*.test.js\"",
    "test:frontend": "vitest run --config frontend/vite.config.ts --reporter=dot",
    "orcamento": "node scripts/orcamento-js.js",
    "verificar-dist": "node scripts/verificar-dist.js",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run orcamento && npm run verificar-dist"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.9",
    "@fontsource/big-shoulders-display": "^5.3.0",
    "@hookform/resolvers": "^7.0.5",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.105.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fastify": "^5.12.8",
    "lucide-react": "^1.70.0",
    "postgres": "^4.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "overrides": {
    "light-my-request": "6.6.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-socket": "^0.2.19",
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
