# Copie para .env ou rode `npm run setup`, que cria o .env com segredos gerados.

# Porta do servidor.
PORT=3000

# Segredo usado para assinar o token CSRF. O setup gera um valor aleatório.
SEGREDO_SESSAO=

# 1 = escuta na rede local (exige senha definida). 0 = só localhost.
EXPOR_NA_REDE=0

# Caminhos do certificado e da chave para responder em HTTPS (opcional).
HTTPS_CERT=
HTTPS_KEY=

# Hosts extras aceitos, separados por vírgula. Ex.: meu-pc.tailnet-1234.ts.net
ORIGENS_PERMITIDAS=
