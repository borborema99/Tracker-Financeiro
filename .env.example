# Copie para .env ou rode `npm run setup`, que cria o .env e gera os três segredos abaixo.
# Estas variáveis ficam SÓ no servidor (no Netlify: Site configuration > Environment variables, marcadas como
# secretas). Nenhuma delas vai para o navegador e nenhuma pode ter o prefixo VITE_.

# Porta do servidor local (npm start / npm run dev).
PORT=3000

# Postgres do Supabase pelo pooler em modo transação (porta 6543). Vazio = desenvolvimento local com PGlite
# em data/pglite, sem conta nenhuma.
DATABASE_URL=

# Supabase Storage (comprovantes). Vazio = os arquivos ficam em data/anexos, só para desenvolvimento local.
# A service key tem poder total sobre o projeto: nunca a coloque no código nem em variável VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Gerados pelo `npm run setup`. NÃO troque o SENHA_PEPPER depois de cadastrar usuários: todas as senhas deixariam
# de funcionar. Guarde uma cópia dele.
SEGREDO_SESSAO=
SENHA_PEPPER=
HMAC_CHAVE_IP=

# 1 = a tela de cadastro público existe. Qualquer outro valor: a rota /api/cadastro responde 404 e as contas
# nascem por `npm run criar-usuario -- <usuario>`.
CADASTRO_ABERTO=0

# Endereço público do site, sem barra no final. Ex.: https://meu-tracker.netlify.app
SITE_URL=

# Hosts extras aceitos, separados por vírgula (domínio próprio, por exemplo).
ORIGENS_PERMITIDAS=
